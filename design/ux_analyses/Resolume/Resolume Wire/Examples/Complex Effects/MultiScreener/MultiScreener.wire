						"type": "float",
						"value": [
							0,
							0
						]
					},
					"trigger": {
						"type": "trigger",
						"value": [
							null,
							null
						]
					}
				},
				"hidden": [
					"signal-type",
					"instances"
				],
				"name": "Snapshot"
			},
			"104": {
				"attributes": {
					"instances": {
						"type": "integer",
						"value": 2
					}
				},
				"bounds": {
					"height": 130,
					"width": 195,
					"x": -3646.571533203125,
					"y": 1859.25048828125
				},
				"class": {
					"id": "77697265-FD65-470F-9F75-ED878267980E",
					"version": 1
				},
				"clock": "video",
				"color": "fff26eb5",
				"constants": {
					"enabled": {
						"type": "bool",
						"value": [
							true,
							true
						]
					},
					"frequency": {
						"type": "float",
						"value": [
							1,
							1
						]
					},
					"reset": {
						"type": "trigger",
						"value": [
							null,
							null
						]
					}
				},
				"hidden": [
					"instances",
					"count"
				],
				"name": "Metronome"
			},
			"105": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "INPUT\n\nAs you know by now, each modulator is instanced to 2.\nThis is why we take two parameters and join them into a collection using the Join node.\n\nThe Reset Modulation Trigger In does not need to be instanced as we want to reset both instances of each oscillator at the same time.\n\nThe first instance of the Phase Offset parameter is set to 0 to make the effect as consistent and predictable as possible. If you don’t know what Phase Offset is I encourage you to check out the example patches of the oscillators."
					}
				},
				"bounds": {
					"height": 773.143310546875,
					"width": 793.0682373046875,
					"x": -4698.93212890625,
					"y": 298.97589111328125
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffff6a00",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"106": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "MODULATORS\n\nI know what you think: yikes! That’s a lot of cords.\nAnd you are right, but we’re basically doing the same thing 6 times in a row.\n\nWe have 6 oscillators, 5 built in in Wire and one custom Sample & Hold where we’ll get to in a bit.\n\nEach oscillator is instanced twice, one oscillator for the X axis and on for the Y Axis.\nEach oscillator receives values for its amplitude, frequency, reset phase and phase offset(if relevant) from the input section of the patch.\n\nNext we split up the two instances of each oscillator using the Split node.\nThis gives us two single values instead of an instanced signal.\nThe first signal goes in a Switch and becomes “X modulator”, the second signal goes into a Switch to become “Y modulator”.\nThe separate signals are packed into a Float 2 using the Pack node and sent to the MODULATING THE GRID-bit we discussed earlier. \n\nThe final modulator choice is called Random, but you might have noticed that we don’t actually use the Random node here. This is mostly because the Random node only works at event flow and we would need quite a bit of patching to get it to work at signal flow.\n\nFor this reason we use a Perlin Noise node (which is basically smoothed noise).\nInstead of connecting the frequency input to the Perlin noise, we connect it to a Metronome instead. The Metronome will trigger the Snapshot node. The Snapshot node will take a snapshot of the Perlin Noise values when triggered and send it out to the Switch.\nThis kind of behavior is often called sample and hold."
					}
				},
				"bounds": {
					"height": 1943.302001953125,
					"width": 1905.2193603515625,
					"x": -3758.34033203125,
					"y": 96.53742218017578125
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "fff26eb5",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"108": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "BLACK BACKGROUND\n\nThe black background effect is seen in quite some effects\/sources in Arena and Avenue and can be made easily. We simply take a Video Mixer and send the important bit to the top layer and a solid black color to the  bottom layer.\n\nNext we add a Bool In to the opacity inlet to toggle the effect on and off.\nThe inlet wants a Float, so it converts the Boolean to a float.\nTrue = 1, False = 0. This gives us an easy on\/off switch for the black background."
					}
				},
				"bounds": {
					"height": 547.27105712890625,
					"width": 779.62933349609375,
					"x": 1102.9935302734375,
					"y": -448.88885498046875
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ff2dc18a",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"109": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "ORDERING THE SCREENS\n\nAfter we have transformed our windows by multiplying the grid with the modulator we want to change the order in which the screens are rendered. This is completely optional, but we think it is a cool effect.\n\nThe first instance in a collection is rendered first, this means that the last instance in a collection is “on top”.\n\nWe give the user two options to change the render order.\nThe Shuffle node will simply randomize the order of the windows.\nShift will take that randomized collection and move the order around.\nBoth functions can be used to great effect in Arena\/Avenue when you add envelopes to them.\n\nFinally we merge the 4 signals into a single signal using the Merge node.\nThis is because we don’t want to affect the individual anymore and cutting down on the amount of instances always saves you processing power.\n"
					}
				},
				"bounds": {
					"height": 676.80218505859375,
					"width": 1024.2894287109375,
					"x": 32.0562744140625,
					"y": -582.8150634765625
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffe53357",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"110": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "THE GRID\n\nThe concept of this patch is to distribute the 4 copies of the incoming texture onto a grid.\nThe grid has to take the resolution of the patch into consideration.\nThe grid is just 4 Float 2 values (coordinates if you will), which we modulate using our modulators and apply to the X\/Y position of the textures.\n\nHere we start out with the Grid Pattern node, which creates the grid.\nWe’ve set the Grid Pattern node to 2 columns and 2 rows in the inspector, giving us 4 float 2 values. The size parameter is the spacing between the coordinates.\n\nTo make the grid resolution dependent, we take the resolution output from the Patch Info node and divide it by either 4, 3, 2 or 1. At a division of 4  and a Window Scale of .5 the textures can’t leave the window."
					}
				},
				"bounds": {
					"height": 642.723388671875,
					"width": 955.7530517578125,
					"x": -2808.67529296875,
					"y": -622.24591064453125
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffae7bff",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"111": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "MODULATING THE GRID\n\nNow that we have established the grid, it is time to modulate it.\nWe’ll get to the modulators in a bit, but for now just know that the modulators generate a Float 2 value sweeping from -1 to 1.\n\nWe start out with a Boolean In, renamed to “Modulate”.\nThis will toggle the Switch to select between the modulator signal and 1.\n\nWhy 1? Because we Multiply the modulator values with the grid values.\nWhen we multiply the grid coordinates with 1, no changes are made, because math.\nIf the modulator is on, we start multiplying with a float of 2 values between -1 and 1, this causes all kinds of changes to the grid coordinates.\nThis is a great example of doing math with an instanced signal (the grid) and a single value(the modulator). All values in the grid are multiplied by the same amount, giving us perfect mirrored movement.\n\nAfter the multiplication, we Switch between a smoothed and unsmoothed signal. This is mostly useful for smoothing out the Random Modulator or creating beat synced effects using the Modulation Reset trigger.\n\nFinally we get our texture and apply the modulated grid to it with the Transform node.\nWe also give the user control over the scale of the 4 windows by connecting a Float In(renamed “Window Scale”) to the Scale inlet of the transform. Again, we have a single value affecting an instanced signal here."
					}
				},
				"bounds": {
					"height": 876.7589111328125,
					"width": 1653.4603271484375,
					"x": -1683.75439453125,
					"y": -623.951171875
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ff20c7bb",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"112": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": true
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "MULTI SCREENER\n\nThe MultiScreener effect demonstrates how you can make intricate mirroring effects by using multiple copies of the same texture. This example also takes a deep dive into modulators.\n\nIn this example we’ll demonstrate how to make a complex set of modulators.\nWe’ll also demonstrate the power of doing math where the left value is instanced and the right value is a single value.\nWe’ll use the collection nodes Shift and Shuffle to change the render order of the screens and finally we’ll show how to make a “Black Background” toggle that you’ll find on some of the effects in Resolume Arena\/Avenue.\n\nReading Order: The Grid, Modulating the Grid, Modulators, Input, Ordering the Screens, Black Background."
					}
				},
				"bounds": {
					"height": 230.4807891845703125,
					"width": 953.60943603515625,
					"x": -1655.3275146484375,
					"y": -1047.6060791015625
				},
