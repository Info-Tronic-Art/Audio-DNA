        "constants": {},
        "hidden": [
          "text",
          "alignment",
          "font-size",
          "fill"
        ],
        "name": "Comment"
      },
      "173": {
        "attributes": {
          "alignment": {
            "type": "integer",
            "value": 0
          },
          "fill": {
            "type": "bool",
            "value": true
          },
          "font-size": {
            "type": "float",
            "value": 19
          },
          "text": {
            "type": "string",
            "value": "Source Control\n\nWe have two main controls for source texture: speed and radius.\nThe speed modifies the speed of the distortion and the radius the general sense of size of the distortion.\n"
          }
        },
