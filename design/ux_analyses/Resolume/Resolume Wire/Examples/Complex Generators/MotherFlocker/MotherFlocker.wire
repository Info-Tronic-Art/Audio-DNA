			"62": {
				"attributes": {
					"instances": {
						"type": "integer",
						"value": 1
					}
				},
				"bounds": {
					"height": 82,
					"width": 132,
					"x": 3040.13232421875,
					"y": -205.1591796875
				},
				"class": {
					"id": "77697265-BEEA-4D38-8EE5-0EBA4CBD0AEE",
					"version": 1
				},
				"clock": "video",
				"color": "ffd0c117",
				"constants": {
					"input": {
						"type": "texture2d",
						"value": null
					}
				},
