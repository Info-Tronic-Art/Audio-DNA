					"version": 1
				},
				"clock": "video",
				"color": "ffff6a00",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"70": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "COLOR\n\nWe start by selecting colors (feel free to change these).\nThe colors are joined into a collection and we use Expand to mirror the colors (blue, white, brown gets expanded to blue, white, brown, brown, white, blue).\nNext we create a gradient out of this by using the Texture from Data node.\nWe Repeat the texture and then use Slide to animate it."
					}
				},
				"bounds": {
					"height": 588.2474365234375,
					"width": 1500.2745361328125,
					"x": 187.1421966552734375,
					"y": 918.433349609375
				},
