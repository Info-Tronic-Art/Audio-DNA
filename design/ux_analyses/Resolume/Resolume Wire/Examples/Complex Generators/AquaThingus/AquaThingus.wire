			"69": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "GETTING WAVY\n\nWe're using a Fractal Noise node with a sin modifier to create a wavy look.\nThe Sine oscillators move the image back and forth.\nThe Z component of the Float 3 can be used as a seed to create different wave patterns.\nAfter we've created the waves we rotate\/scale them in order to create the symmetrical rotation pattern going with the Repeat node. "
					}
				},
				"bounds": {
					"height": 607.95263671875,
					"width": 1298.51318359375,
					"x": 187.1421966552734375,
					"y": 273.426483154296875
				},
				"class": {
