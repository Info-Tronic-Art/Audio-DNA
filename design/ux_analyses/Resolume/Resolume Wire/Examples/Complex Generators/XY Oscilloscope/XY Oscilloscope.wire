				"name": "Perlin Noise"
			},
			"67": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "OSCILLATOR CONTROL\n\nHere we create a Float 2 collection from two instanced Sine oscillators.\nEach oscillator has 1000 instances, the size of this collection is controlled by the Linear nodes.\nEach oscillator has individual frequency, amplitude and phase controls."
					}
				},
				"bounds": {
					"height": 884.0341796875,
					"width": 858.0655517578125,
					"x": -789.5462646484375,
					"y": 256.8310546875
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffff6a00",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"68": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "MESH 2D\n\nWe start the mesh process by creating a Circle node.\nNote that the subdivisions are turned all the way down.\nBecause we are working on such a miniature scale (note the 0.1 scale in the Transformation2D node), we don't need the subdivisions.\n\nNext we apply the transformation info from the oscillators to the meshes by using the Transformation2D node.\nThe color is supplied by the Texture Material node."
					}
				},
				"bounds": {
					"height": 884.0341796875,
					"width": 858.0655517578125,
					"x": 113.86998748779296875,
					"y": 256.8310546875
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ff02bbff",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
