			"86": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "We start by rounding a Rectangle and creating an edge out of with with variable thickness.\nNext, we use a Triangle oscillator, over a Curve to create a cool looking rotation pattern.\nLastly, we use another Linea rnode to offset the scale of each shape.\nNote that the two non-modulated Linear nodes are set to attribute flow.\nSince we only need to calculate this list of numbers once, we can safe some computing power by setting them to attribute flow."
					}
				},
				"bounds": {
					"height": 574.69293212890625,
					"width": 1043.5098876953125,
					"x": 920.9632568359375,
					"y": 32.81585311889648438
				},
