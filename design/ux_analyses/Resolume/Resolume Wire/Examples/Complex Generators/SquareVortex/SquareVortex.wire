						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "First we Merge the collection of 60 shapes down to a single shape by using Merge.\nAfter that we do the final transform before rendering the shape to a texture.\nBy merging first we save processing power, because instead of 60 Transforms, we now only need 1."
					}
				},
