				"bounds": {
					"height": 30,
					"width": 195,
					"x": -1025.63037109375,
					"y": 354.867462158203125
				},
				"class": {
					"id": "77697265-1296-4264-A646-5CE3BE529286",
					"version": 1
				},
				"clock": "video",
				"color": "fff26eb5",
				"constants": {
					"input0": {
						"type": "float2",
						"value": [
							0,
							0
						]
					}
				},
				"hidden": [
