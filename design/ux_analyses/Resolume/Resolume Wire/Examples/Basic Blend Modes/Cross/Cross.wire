					"input0-type",
					"input0-dimensions"
				],
				"name": "Negate"
			},
			"41": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "RESOLUTION\n\nWe want to make four copies of the incoming texture and move them into the screen.\nThe issue here is that we are dealing with pixels, so when we run at any other resolution than 1920x1080 it wouldn’t work. This is where the patch info nodes comes into play.\n\nThis node outputs the resolution of the patch as a Float2 (width in pixels, height in pixels).\nWe use the Unpack node to get the width and height separately.\n\nNext we pack it back into a Float 2, but leave out either the width or height.\nBecause we want to make a cross\/plus pattern we only move over the X or Y axis.\nWe negate the two Pack’s to get the “opposite side”\n\nFinally we put all the coordinates into one collection using the Join node.\nWe want to control four textures (left, right, up and down) so we need a collection of 4."
					}
				},
				"bounds": {
					"height": 638.0892333984375,
					"width": 1351.690185546875,
					"x": -1854.2288818359375,
					"y": -209.3912353515625
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "fff26eb5",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"42": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "THE MIX\n\nThe Mix node is a renamed Float In node that will blend the signal in and out.\nWe use the 1-x node to change the signal from 0 to 1 to 1 to 0 (hover over the outlets of both nodes to observe the difference).\n\nNext we multiply the input with our coordinates.\nWhen our Mix is at 0, the 1-x will be at 1.\n1 gets multiplied by the coordinates we’ve made before resulting in our textures being moved outside of the view.\n\nAs Mix goes up the multiplier goes down and the textures move in.\nWhen our mix is at 1, the 1-x will be at 0.\nWe multiply the coordinates with 0, the result is 0 and no transform is applied."
					}
				},
				"bounds": {
					"height": 638.0892333984375,
					"width": 960.05926513671875,
					"x": -413.08819580078125,
					"y": -213.97393798828125
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffae7bff",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"43": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "THE OUTPUT\n\nWe use a merge node to turn our 4 textures into 1 and mix that at 100% with the secondary texture before sending it out with the Texture Out node."
					}
				},
				"bounds": {
					"height": 505.188873291015625,
					"width": 676.23809814453125,
					"x": 638.85211181640625,
					"y": -90.0837554931640625
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ff2dc18a",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"44": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": true
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "CROSS\n\nThis tutorial will teach you how to use Pack\/Unpack and Patch Info to make a blendmode that scales with any resolution.\n"
					}
				},
				"bounds": {
					"height": 115,
					"width": 564.41802978515625,
