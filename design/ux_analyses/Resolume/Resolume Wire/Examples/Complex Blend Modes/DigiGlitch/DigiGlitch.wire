					}
				},
				"hidden": [
					"input",
					"instances",
					"flow",
					"has-min",
					"min",
					"has-max",
					"max"
				],
				"name": "Mix"
			},
			"143": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "MASK & MIX\n\nIn the final stage we Subtract the big blocks from the noise, creating noisey blocks.\nNext, we use this as a Mask for the first texture before it gets mixed with the second texture."
					}
