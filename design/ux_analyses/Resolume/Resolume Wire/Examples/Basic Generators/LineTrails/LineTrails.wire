						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "Next we render the lines to a texture using the Shape Render node.\nNote that we are using an near-transparent color for this.\nThis will benefit later when we use a feedback loop to create a more sublte image.\n\nWe use the Hue Rotate node the slowly change the colore of the lines. This affects the hue, but not the alpha."
					}
				},
				"bounds": {
					"height": 482.86248779296875,
					"width": 597.0606689453125,
					"x": 279.5928955078125,
