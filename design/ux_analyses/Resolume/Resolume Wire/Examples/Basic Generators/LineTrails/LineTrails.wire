			},
			"118": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "Now, to create the feedback loop we patch the video mixer back into itself.\nThis will create trails.\nWe take the signal, blur it with the Blur node and combine the blurred and non-blurred images in another Video Mixer"
					}
				},
				"bounds": {
					"height": 482.86248779296875,
					"width": 997.62091064453125,
					"x": 936.67401123046875,
