					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "Here we have a sneaky little reset trigger.\nWhen the trigger is hit we send a 0 to the opacity, clearing the feedback.\nAfter a delay of 0.005 seconds we send a 1 to set the opacity back to 1 which restarts the feedback."
					}
				},
