          "text": {
            "type": "string",
            "value": "SMOOTHING THE TRANSITION\n\nThe translation, rotation and scale are all sent to their own Smooth nodes.\nThe Smooth node will smooth out the changes from the first to second value over a given time. For this we created a Transition Time slider (a Float In node). Here we see another suffix: seconds."
          }
        },
        "bounds": {
          "height": 403.29934692382807,
          "width": 488.83880615234375,
          "x": 92.12831115722656,
          "y": 131.10372924804688
        },
        "class": {
          "id": "77697265-3C1D-467D-A722-0FC566538374",
          "version": 1
        },
        "clock": "video",
        "color": "ff20c7bb",
        "constants": {},
        "hidden": [
          "text",
          "alignment",
          "font-size",
          "fill"
        ],
        "name": "Comment",
        "thumbnail_visible": true
      },
      "2": {
        "attributes": {
          "instances": {
            "type": "integer",
