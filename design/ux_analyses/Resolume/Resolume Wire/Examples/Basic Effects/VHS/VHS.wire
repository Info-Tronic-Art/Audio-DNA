		"nodes": {
			"11": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "Grid draws a grid of horizontal and vertical lines over its input signal. Because we've set the amount of columns to just 1, the node only draws horizontal rows.\n\nWe use this to simulate scanlines, as you used to see on old CRT monitors.\n\nThis Saw, which ramps up from 0 to 3, drives the amount of vertical scroll.\n\nThe scroll node simply scrolls an input image left\/right and top\/bottom. This adds extra visual distortion."
					}
				},
