					"text": {
						"type": "string",
						"value": "Colour aberration is an effect commonly associated with old screen technology. It offsets the red, green an blue channels of a video signal.\n\nIn this case, both green and blue channles are offset by two random signal paths. We use the Color Offset node to achieve this effect."
					}
				},
				"bounds": {
					"height": 300.007232666015625,
					"width": 479.011077880859375,
