			"18": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "MANIPULATING NUMBERS\n\nThis is where the interesting stuff starts! \nThese are a couple of nodes that let you quickly manipulate values by rounding or reversing them.\n\nIn the example we start with a Sine oscillator that runs from -1 to 1 (the red dot).\n\nThe Quantize node is used to quantize the oscillator into discrete steps of 0.25 (the green dot).\n\nThe Round node is used to round the output of the oscillator resulting in either -1, 0  or 1 (the blue dot).\n\nThe Absolute node calculates the absolut of the Sine.\nThis means that the value cannot go negative (the yellow dot).\n\nThe Negate node will make any negative value positive and positive value negative (the purple dot).\n"
					}
				},
				"bounds": {
					"height": 806.43658447265625,
					"width": 2072.391845703125,
					"x": 292,
					"y": 1092.7711181640625
