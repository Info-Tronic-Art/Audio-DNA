			"31": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "MAP\n\nThis is a node that every patcher worth its salt should know about.\nThe Map node takes a value range and remaps it to another value range.\nThis is ideal for when you want parameters that run from 0 to 1, but you need a specific range.\n\nIn this example we take the 0 to 1 range of the Float In node and remap it to a 0.01 to 0.1 range.\nDo note that in order for this node to work, you need to know the input range.\n"
					}
				},
				"bounds": {
					"height": 742.8240966796875,
					"width": 1018.42816162109375,
					"x": 291.9774169921875,
					"y": 1954.278564453125
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ff20c7bb",
