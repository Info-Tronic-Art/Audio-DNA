			"128": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE\n\nIn this example we are using a bunch of Linear nodes to offset the phase of the Sine oscillators.\nBy using differently sized collections, frequency and amplitude we generate a complex movement pattern for the Circle node.\n\nMore Linear nodes are used to create a shape grid from Rectangle nodes.\nThe collections are merged and thrown into a Union node which helps with the liquid look.\nA feedback loop is used to create depth (You will learn about this soon!)."
					}
				},
				"bounds": {
					"height": 1263.7060546875,
					"width": 2711.72265625,
					"x": 80.57879638671875,
					"y": 3208.935791015625
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ff2dc18a",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment",
				"thumbnail_visible": true
			},
			"129": {
				"attributes": {
					"instances": {
						"type": "integer",
						"value": 1
					}
				},
				"bounds": {
					"height": 82,
					"width": 132,
					"x": 2254.660888671875,
					"y": 3634.9638671875
				},
				"class": {
					"id": "77697265-BEEA-4D38-8EE5-0EBA4CBD0AEE",
					"version": 1
				},
				"clock": "video",
				"color": "ff2dc18a",
