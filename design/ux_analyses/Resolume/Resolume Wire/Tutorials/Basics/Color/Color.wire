			"description": "A deep dive into how color works in Wire. Learn how to generate, modify and randomize colors.",
			"displayName": "Color",
			"identifier": "50d9161c-5416-42a7-a95c-54ec12b92598",
			"licenseName": "",
			"mail": "",
			"originalTarget": {
				"branch": "master",
				"name": "Wire",
				"version": {
					"major": 7,
					"minor": 18,
					"patch": 0
				}
