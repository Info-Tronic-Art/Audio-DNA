          "font-size",
          "fill"
        ],
        "name": "Comment",
        "thumbnail_visible": true
      },
      "6": {
        "attributes": {
          "alignment": {
            "type": "integer",
            "value": 0
          },
          "fill": {
            "type": "bool",
            "value": false
          },
          "font-size": {
            "type": "float",
            "value": 19
          },
          "text": {
            "type": "string",
            "value": "VIDEO SOURCE\n\nThe Video Source category contains a set of nodes that produce textures.\nAll these nodes produce the Texture2Drgba type, which contains color data for all four channels.\n\nSome of these nodes are deadly simple like the UV Texture or Static node.\nOthers have tons of parameters to tweak and play with, like the Metaballs or Fractal Noise nodes.\n\nAssignment: explore the Video Source category."
          }
        },
        "bounds": {
