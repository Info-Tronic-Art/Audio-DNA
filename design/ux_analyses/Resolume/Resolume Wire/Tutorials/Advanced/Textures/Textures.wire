				"thumbnail_visible": true
			},
			"19": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "TEXTURE2Dchannel\n\nThe Texture2Drgba type consists of four channels: red, green, blue and alpha.\nAs you might have guessed, the Texture2Dchannel type consists of a single channel.\n\nThe Texture2Dchannel type can be extracted from a Texture2Drgba type by using the Unpack or Element nodes. Unpack will give you all the channels while Element can extract a specific channel for you.\n\nThe Texture2Dchannel is a grayscale texture.\n"
					}
				},
				"bounds": {
					"height": 740.05108642578125,
					"width": 712.1607666015625,
					"x": 557.09197998046875,
					"y": 48.94585037231445312
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ff02bbff",
				"constants": {},
				"hidden": [
