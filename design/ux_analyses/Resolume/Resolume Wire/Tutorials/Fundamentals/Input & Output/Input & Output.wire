        "color": "ff02bbff",
        "constants": {},
        "hidden": [
          "text",
          "alignment",
          "font-size",
          "fill"
        ],
        "name": "Comment",
        "thumbnail_visible": true
      },
      "56": {
        "attributes": {
          "flow": {
