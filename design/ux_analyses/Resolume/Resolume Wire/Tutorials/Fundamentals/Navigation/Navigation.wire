				"name": "Comment",
				"thumbnail_visible": true
			},
			"4": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "THE CANVAS\n\nThe workspace of wire is called the canvas.\nThe canvas is where you'll find your nodes and comment boxes (like this one).\n\nTo move(pan) around the canvas either:\n- Press the middle mouse button and drag\n- Hold the spacebar and left-click drag\n\nTo zoom the canvas use:\n- The scroll wheel on your mouse\n- A two-finger drag on your trackpad\n- Use the zoom-level menu in the top right corner of the interface.\n\nAssignment: zoom into NODE 1 as far as you can, then use a panning method to find NODE 2."
					}
				},
				"bounds": {
					"height": 470.603424072265625,
					"width": 685.983154296875,
					"x": 286.9293212890625,
					"y": 271.937347412109375
				},
				"class": {
