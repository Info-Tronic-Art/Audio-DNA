			"36": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "PATCH\n\nA project in Wire is referred to as a patch.\nYou could say, 'The patch below is an effect that grows and shrinks the RGB-channels individually'\n\nPatches can be saved, consolidated, compiled and exported from the patch menu.\nFor more information on the topic of saving; read the \"Saving, Consolidating & Copy For Sharing\" article on our website."
					}
				},
				"bounds": {
					"height": 645.4896240234375,
					"width": 1707.293212890625,
					"x": 287.7789306640625,
					"y": 1320.4112548828125
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffae7bff",
				"constants": {},
				"hidden": [
