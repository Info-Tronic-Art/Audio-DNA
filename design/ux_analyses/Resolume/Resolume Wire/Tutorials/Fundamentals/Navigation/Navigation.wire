			},
			"5": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "MONITOR\n\nThe Monitor panel can be found in the bottom right corner of the interface.\nThis panel previews the output of the currently selected node if possible.\n\nAssignment: click on each node below to preview them.\n\nThe monitor can also be locked to a specific node, so you can work on others without shifting focus.\nFirst click on the node you want to lock (we call it pinning a node).\nNext, click on the gray pin in the bottom left corner of the monitor to pin it.\nClick again to unpin it.\n\nAssignment: try pinning and unpinning the nodes below."
					}
				},
