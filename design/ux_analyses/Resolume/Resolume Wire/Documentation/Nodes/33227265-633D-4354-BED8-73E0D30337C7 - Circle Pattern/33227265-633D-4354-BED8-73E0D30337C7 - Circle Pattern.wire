			},
			"18": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 2: CHAOS CIRCLE\n\nIn this example we're complicating the pattern a little more by introducing some chaos.\nWe are multiplying the values from the Circle Pattern (which are Float2) with an instanced Perlin Generator node (which produces a float signal).\nThis adds a little movement as the static values for the Circle Pattern are being influenced by the ever changing values of the Perlin Generator node.\nFor color we create a Linear node in color mode, giving us 64 colors, which we Shuffle to randomly distribute the colors"
					}
				},
				"bounds": {
					"height": 617.7421875,
					"width": 1307.7235107421875,
					"x": 109.427978515625,
