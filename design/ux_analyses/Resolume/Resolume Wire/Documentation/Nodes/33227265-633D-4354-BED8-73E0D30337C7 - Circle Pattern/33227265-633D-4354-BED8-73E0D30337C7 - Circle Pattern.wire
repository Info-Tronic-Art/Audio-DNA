					"text": {
						"type": "string",
						"value": "EXAMPLE 1: SHAPES IN A CIRCLE PATTERN\n\nIn this example we're taking a Circle shape and use the Move node to put them in the pattern provided by the Circle Pattern node.\nGive the angle slider a try to see the folding\/unfolding of the pattern yourself."
					}
				},
				"bounds": {
					"height": 326.241455078125,
					"width": 840.768798828125,
					"x": 109.42798614501953125,
					"y": 383.14886474609375
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffff6a00",
				"constants": {},
				"hidden": [
