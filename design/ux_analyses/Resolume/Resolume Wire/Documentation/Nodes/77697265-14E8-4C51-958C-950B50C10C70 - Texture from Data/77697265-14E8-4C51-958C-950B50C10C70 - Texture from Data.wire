					"fill"
				],
				"name": "Comment",
				"thumbnail_visible": true
			},
			"40": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 1: FLOAT TO TEXTURE\n\nIn this example we are converting a collection of 50 float values generated by the Random node.\nThe result is a texture2Dchannel type since we are using floats.\nNote that nearest sampling is used, feel free to change it to see the difference between the nearest and linear modes"
					}
				},
