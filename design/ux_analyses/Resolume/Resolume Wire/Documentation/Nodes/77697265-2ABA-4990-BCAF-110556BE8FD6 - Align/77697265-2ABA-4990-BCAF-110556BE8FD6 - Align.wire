{"formatVersion":{"major":1,"minor":1,"patch":0},"patch":{"connections":[{"from":[68,"output"],"to":[70,"input"]},{"from":[69,"output"],"to":[71,"shape"]},{"from":[71,"output0"],"to":[68,"input"]},{"from":[74,"trigger"],"to":[72,"trigger"]},{"from":[80,"output"],"to":[68,"margin-x"]},{"from":[80,"output"],"to":[68,"margin-y"]},{"from":[72,"output0"],"to":[73,"input"]},{"from":[72,"output0"],"to":[78,"input"]},{"from":[78,"output0"],"to":[79,"input0"]},{"from":[79,"output0"],"to":[80,"selection"]},{"from":[73,"output0"],"to":[68,"alignment"]}],"meta":{"author":"Mark Buitenwerf","category":null,"description":"Explains what this node does.","displayName":"Align Example","identifier":"bdd56c96-3569-47cd-aa77-561bfff41cb0","licenseFile":"","licenseName":"","mail":"mail@resolume.com","quality":32856,"resolution":{"height":1080,"width":1920},"thumbnail":"","url":"www.resolume.com","vendor":"Resolume"},"nextNodeId":89,"nodes":{"36":{"attributes":{"font-size":{"type":"number","value":19},"text":{"type":"text","value":"OUTLETS\n\n• Main\nOutputs a Texture2D\n\n"}},"bounds":{"height":380,"width":334,"x":680.735595703125,"y":1016.50836181640625},"class":{"id":"77697265-3C1D-467D-A722-0FC566538374","version":0},"clock":"video","constants":{},"hidden":[],"name":"Comment"},"37":{"attributes":{"font-size":{"type":"number","value":19},"text":{"type":"text","value":"INLETS\n\n• Input\nInput a texture.\n\n• Bypass\nInput a Bool to bypass this node.\n\n• Alignment\nInput an Int or Float to select the aligment that is applied to the texture.\n\n• Margin X\nThe width of the margin.\n\n• Margin Y\nThe height of the margin."}},"bounds":{"height":384,"width":312,"x":311.683197021484375,"y":1016.88336181640625},"class":{"id":"77697265-3C1D-467D-A722-0FC566538374","version":0},"clock":"video","constants":{},"hidden":[],"name":"Comment"},"39":{"attributes":{"font-size":{"type":"number","value":19},"text":{"type":"text","value":"ALIGN\nThe Align node aligns a textures on to set points on the screen. This is useful when positioning your texture. A margin can be set to create borders within the screen. Note that to see effect the used texture has to be less than the composition size.\n\n- Patch Explained -\n\n• The Circle goes into the Shape Render transforming it from a Shape2D to a Texture2D.\n• The Shape Render renders the texture at 480x270, this is set in the inspector.\n• The texture goes into the Align node where it is aligned to different positions on the screen.\n• Using a system of triggers and logic nodes we browse through all alignment positions and switch between no margin and a margin of 1000 pixels."}},"bounds":{"height":215.760528564453125,"width":1115.4273681640625,"x":311.544342041015625,"y":323.37091064453125},"class":{"id":"77697265-3C1D-467D-A722-0FC566538374","version":0},"clock":"video","constants":{},"hidden":[],"name":"Comment"},"68":{"attributes":{"bitdepth":{"type":"choice","value":"Patch Bit Depth"},"instances":{"type":"number","value":1},"resolution":{"type":"choice","value":"Patch Size"}},"bounds":{"height":106,"width":195,"x":1476.0745849609375,"y":590.7249755859375},"class":{"id":"77697265-2ABA-4990-BCAF-110556BE8FD6","version":0},"clock":"video","constants":{"alignment":{"type":"integer","value":8},"bypass":{"type":"bool","value":false},"input":{"type":"texture2d","value":null},"margin-x":{"type":"float","value":1000},"margin-y":{"type":"float","value":1000}},"hidden":["bypass"],"name":"Align"},"69":{"attributes":{"instances":{"type":"number","value":1}},"bounds":{"height":58,"width":195,"x":547.4205322265625,"y":591.343505859375},"class":{"id":"77697265-EA26-47D6-985A-B4CAEC314BF7","version":0},"clock":"video","constants":{"radius":{"type":"float","value":0.30000001192092896}},"hidden":[],"name":"Circle"},"70":{"attributes":{"instances":{"type":"number","value":1}},"bounds":{"height":82,"width":132,"x":1705.0745849609375,"y":590.7249755859375},"class":{"id":"77697265-BEEA-4D38-8EE5-0EBA4CBD0AEE","version":0},"clock":"video"