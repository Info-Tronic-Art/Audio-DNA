						"value": 19
					},
					"text": {
						"type": "string",
						"value": "INTEGER\nThe Int node can be used to convert booleans, floats and string to integers.\nAn integer is a whole number, It can be negative, positive or 0. \nFor a value to be an integer, a number cannot be a decimal or a fraction.\n\nFor example: -123, -1, 0, 3, 22, 77, 640, etc."
					}
				},
				"bounds": {
					"height": 140.7950286865234375,
					"width": 523,
					"x": -301.779296875,
					"y": 39.5806884765625
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffd0c117",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"4": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 3: STRING TO INT\nConnect a String to the Int node and it will try to convert it to an Int. \nWhen you type in \"Dial 911!\" it will obviously not succeed and return the default value instead. But when you enter \"911\" it will work just fine."
					}
				},
				"bounds": {
					"height": 299.56256103515625,
					"width": 517.3258056640625,
