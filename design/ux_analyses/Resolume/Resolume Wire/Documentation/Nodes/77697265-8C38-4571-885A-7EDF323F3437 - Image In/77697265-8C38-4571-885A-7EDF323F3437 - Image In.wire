          "fill": {
            "type": "bool",
            "value": false
          },
          "font-size": {
            "type": "float",
            "value": 19
          },
          "text": {
            "type": "string",
            "value": "EXAMPLE\n\nIn this example we've loaded an image into the Image In node.\nWe use this image to UV-Offset the incoming test card texture.\nThis allows us to create an image-based distortion effect."
          }
        },
