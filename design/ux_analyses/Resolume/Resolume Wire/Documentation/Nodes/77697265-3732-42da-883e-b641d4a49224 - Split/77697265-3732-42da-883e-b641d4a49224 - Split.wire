			"27": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 1: SPLITTING UP A SEQUENCE\n\nIn this example we're taking a Sequence node that generates a collection of integers running from 0 to 9.\n\nNext we split these up into separate integers.\nYou can see how the channels are splitted by hovering over the outlets of the Split node."
					}
				},
				"bounds": {
					"height": 478.895416259765625,
					"width": 513.98138427734375,
					"x": 208.847808837890625,
					"y": 170.923828125
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
