						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 2: FLIPPING A GRADIENT\n\nIn this example we create a gradient by converting a Linear node to a texture with the Texture from Data node.\nWe flip the gradient around with the Reverse node and toggle between the regular and reversed gradient by sending a Metronome into a Toggle node.\nThe Smooth node is added to smoothly transition between color values.\nNote that we are reversing a collection of colors values, not textures."
					}
				},
				"bounds": {
					"height": 532.56414794921875,
					"width": 1472.133056640625,
					"x": -289.262542724609375,
					"y": 530.31396484375
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ff20c7bb",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment",
				"thumbnail_visible": true
			},
			"106": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 3: REVERSING THE RENDERING ORDER\n\nIn this example we start with a test card from the Texture In node, which we Colorize twice and then Join together to form a collection.\nThe first instance gets moved 100 pixels to the left and the second instance is moved 100 pixels to the right.\n\nBy reversing the collection we change the order at which the textures are rendered to your screen."
					}
				},
