					"fill"
				],
				"name": "Comment",
				"thumbnail_visible": true
			},
			"5": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "Example 1: Color Flipping\n\nIn this example we start with a Gradient node, which gives us a Texture2D RGBA signal.\nNext we unpack this signal and we end up with 4 Texture2D Channel signals, one for each channel.\nAfter this we create a Texture2D RGBA signal again by using the Texture from Channels node.\nBut note that we have now send the red channel in to the blue channel and the blue channel into the red channel.\nThe result is a color flip."
					}
				},
				"bounds": {
					"height": 372,
					"width": 958,
					"x": 127,
					"y": 238
				},
				"class": {
