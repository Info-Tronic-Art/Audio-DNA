					},
					"text": {
						"type": "string",
						"value": "TEXTURE FROM CHANNELS\n\nThe Texture from Channels node contstructs a Texture2D RGBA signal out of Texture2Dchannel signals.\nThe node wants a Texture2Dchannel signal for each color channel as well as the alpha channel."
					}
				},
				"bounds": {
					"height": 124,
					"width": 746.88531494140625,
					"x": 127,
					"y": 76
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffd0c117",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
