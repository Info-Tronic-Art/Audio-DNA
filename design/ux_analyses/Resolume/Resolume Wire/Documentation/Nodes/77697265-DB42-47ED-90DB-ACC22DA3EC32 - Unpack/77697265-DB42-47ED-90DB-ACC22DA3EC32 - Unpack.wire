					"text": {
						"type": "string",
						"value": "UNPACK\n\nThe Unpack node splits up types into separate elements.\nFor example: A Float4 type can be split into 4 separate float values\n\nIf you need to extract a single element from a type you should use the Element node instead."
					}
				},
				"bounds": {
					"height": 157.642486572265625,
					"width": 524.10711669921875,
					"x": 108.1156768798828125,
