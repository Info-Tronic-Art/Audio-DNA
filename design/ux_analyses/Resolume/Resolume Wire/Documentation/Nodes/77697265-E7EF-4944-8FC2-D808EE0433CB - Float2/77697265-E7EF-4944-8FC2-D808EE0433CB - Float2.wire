						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 1: MANUAL X\/Y POSITIONS\n\nIn this example there are two Float In nodes, renamed to X and Y.\nWe use the Float 2 node to combine them into a float 2 type.\n\nUse the sliders to move the rectangle around."
					}
				},
				"bounds": {
					"height": 524.747314453125,
					"width": 934.02294921875,
					"x": -8.11138916015625,
					"y": 287.2188720703125
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffff6a00",
				"constants": {},
				"hidden": [
					"text",
					"alignment",
					"font-size",
					"fill"
				],
				"name": "Comment"
			},
			"11": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 2: COLOR OFFSET\n\nThere are many other nodes that want a float 2 type for their inlets.\nIn this example we are using the Color Offset node to demonstrate this.\nThe Sine oscillator generates a float value between -200 and 200.\nThe Float2 node is used to turn the float value into a float2.\nNote that we are leaving the Y at 0, we only want the effect to apply horizontally.\nTry changing it to Y or X and Y and play around with the different channel routings."
					}
				},
				"bounds": {
					"height": 524.747314453125,
					"width": 934.02294921875,
					"x": -9.32155990600585938,
