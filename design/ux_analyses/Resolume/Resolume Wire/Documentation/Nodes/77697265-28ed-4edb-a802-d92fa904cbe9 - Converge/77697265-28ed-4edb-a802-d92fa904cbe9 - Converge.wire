			"2": {
				"attributes": {
					"font-size": {
						"type": "number",
						"value": 19
					},
					"text": {
						"type": "text",
						"value": "CONVERGE\n\nThe Converge node combines a multi-channel event (instanced event) into a single channel.\n\nThis is useful for situations, where you have two node paths with different instance counts. You want to merge them and you don't care about the instancing.  \n\nIn this example it prevents the MIDI out node from repeating the bottom Write Note On node. That node has 3 instances and the top node has 5.\nWire automatically fixes that for you by repeating the collection, but sometimes  you don't want this behavior. Converge is an excellent choice for those situations."
					}
				},
				"bounds": {
					"height": 252,
					"width": 630,
					"x": 699,
					"y": 226
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 0
				},
				"clock": "video",
				"constants": {},
