          "fill"
        ],
        "name": "Comment"
      },
      "11": {
        "attributes": {
          "alignment": {
            "type": "integer",
            "value": 0
          },
          "fill": {
            "type": "bool",
            "value": false
          },
          "font-size": {
            "type": "float",
            "value": 19
          },
          "text": {
            "type": "string",
            "value": "EXAMPLE\n\nIn this example we combine the geometry from the Rectangle, the transformation data from Transformation 2D and the material converted from the Texture in to create a Mesh2D"
          }
        },
