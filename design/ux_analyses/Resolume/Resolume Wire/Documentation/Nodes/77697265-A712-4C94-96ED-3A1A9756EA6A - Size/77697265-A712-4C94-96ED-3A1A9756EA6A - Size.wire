					},
					"text": {
						"type": "string",
						"value": "SIZE\n\nSize outputs the size of the incoming collection as an integer at attribute flow.\n\nThis node is often used to adjust the scale\/size of a node that produces a collection to another collection's size."
					}
				},
				"bounds": {
					"height": 133.1002197265625,
					"width": 722.36767578125,
					"x": 323.914031982421875,
					"y": 65.86322021484375
				},
				"class": {
