				"name": "Comment"
			},
			"20": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 2: SCALING TO INSTANCE COUNT\n\nIn this example we have a row of rectangles that shirnk in turn.\nTo do this we start with a Rectangle node that we Expand to the amount of recangles we want (10 by default, but feel free to play around).\nThis collection or rectangles is sent over to the Transform node where we place them in a row and shrink them one at a time.\n\nThe Size node gives us the Size of the collection of rectangles.\nWe send this value to the size inlets of both Linear nodes and the amplitude of the Saw node.\nAs we increase and decrease the output size of the Expand node, everything gets updated according to the current size."
					}
				},
				"bounds": {
					"height": 735.552490234375,
					"width": 2238.2158203125,
					"x": 322.311187744140625,
					"y": 915.854248046875
