					},
					"text": {
						"type": "string",
						"value": "EXAMPLE\n\nIn this example we use the Sample Texture node to sample the pixel at X 150, Y 150 (note that the origin is at the bottom-left).\nThe color we get from this sampling is then used to colorize the rectangle shape placed in the bottom right corner of the patch."
					}
				},
				"bounds": {
					"height": 462,
					"width": 1211,
					"x": 277.5,
