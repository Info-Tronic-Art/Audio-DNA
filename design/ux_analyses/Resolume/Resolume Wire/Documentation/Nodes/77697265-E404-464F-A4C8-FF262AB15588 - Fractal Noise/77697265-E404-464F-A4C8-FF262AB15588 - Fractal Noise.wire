				],
				"name": "Group",
				"thumbnail_visible": true
			},
			"109": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 2: ALGORITHM & MODIFIER\n\nEach pixel gets assigned a value between -1 and 1. \nHow the values are distributed depends on the algorithm that you use.\nEach algorithm has a distinct visual style to it. \nThe values of the algorithm are modulated by the modifier. "
					}
				},
