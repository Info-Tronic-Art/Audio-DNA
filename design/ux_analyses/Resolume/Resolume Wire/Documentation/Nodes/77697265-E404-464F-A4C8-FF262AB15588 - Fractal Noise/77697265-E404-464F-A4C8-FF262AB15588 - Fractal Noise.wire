			"108": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": false
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 1: PHASE OFFSET\n\nTechnically speaking the phase offset is the seed used to generate the noise. \nPractically speaking the first two values will scroll you through the X and Y  axis. \nThe third value scrolls through the Z axis. \nBut since we are working in 2D this value can be seen as modulation or time. \nThis is where the magic happens and your noise comes to life. "
					}
				},
				"bounds": {
					"height": 577.83001708984375,
					"width": 895.17095947265625,
					"x": -273.80621337890625,
					"y": -66.901123046875
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffff6a00",
