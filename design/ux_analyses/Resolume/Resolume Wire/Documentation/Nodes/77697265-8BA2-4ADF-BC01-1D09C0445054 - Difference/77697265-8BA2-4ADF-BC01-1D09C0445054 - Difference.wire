					},
					"text": {
						"type": "string",
						"value": "EXAMPLE 1: CIRCLE ONTO RECTANGLE\n\nIn this example we are using the Difference node to bind the circle mesh to the rectangle mesh.\nFirst, we make sure that the Rectangle adheres to the aspect ratio by patching the Patch Info into the width. Next, we take the bounding boxes of both the rectangle and circle and use Difference to bind the circle box to the rectangle box. The result is used to transform the Circle mesh.\n"
					}
				},
				"bounds": {
					"height": 793.3729248046875,
