					"text": {
						"type": "string",
						"value": "VIDEO SAMPLER\n\nThe Video Sampler allows you to sample a video resource at a specific time using the Phase inlet. \nThe Phase takes a value from 0 to 1 to scroll through the video. Values above\/below this range will be wrapped.\n\nThe video resource can be assigned through the node panel, Video Resource node or the Video In node."
					}
				},
				"bounds": {
					"height": 155.7018280029296875,
					"width": 764.18505859375,
					"x": 540.5545654296875,
					"y": 338.81317138671875
				},
