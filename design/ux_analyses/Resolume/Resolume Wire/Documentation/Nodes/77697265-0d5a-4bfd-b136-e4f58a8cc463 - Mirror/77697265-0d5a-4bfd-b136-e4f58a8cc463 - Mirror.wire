{"formatVersion":{"major":1,"minor":1,"patch":0},"patch":{"connections":[{"from":[12,"output0"],"to":[13,"input"]},{"from":[24,"output"],"to":[23,"input"]},{"from":[26,"output"],"to":[25,"input"]},{"from":[23,"output"],"to":[27,"input0"]},{"from":[25,"output"],"to":[27,"input1"]},{"from":[27,"output0"],"to":[12,"shape"]}],"meta":{"author":"","category":null,"description":"This patch explains what this node does.","displayName":"Mirror Example","identifier":"26e76f4d-09c6-4b82-b6f8-6e8aa6933cc5","licenseFile":"","licenseName":"","mail":"","quality":32856,"resolution":{"height":1080,"width":1920},"thumbnail":"","url":"","vendor":""},"nextNodeId":29,"nodes":{"1":{"attributes":{"font-size":{"type":"number","value":19},"text":{"type":"text","value":"MIRROR\nThe mirror node sends out a mirror version of the incoming shape. The slider can be used to adjust the position of the mirror.\n\n- Patch Explained -\n\n• The Circle gets mirrored and sent to the Subtract node.\n• Below that a smaller Circle also gets mirrored and sent to the Subtract node.\n• The two shapes are subtracted from each other and sent to the Shape Render.\n• The Shape Render converts the Shape2D to a texture.\n"}},"bounds":{"height":208,"width":850,"x":111.203125,"y":283.9921875},"class":{"id":"77697265-3C1D-467D-A722-0FC566538374","version":0},"clock":"video","constants":{},"hidden":[],"name":"Comment"},"12":{"attributes":{"antialising-direction":{"type":"choice","value":"In"},"material-dimensions":{"type":"dimensions","value":[]},"resolution":{"type":"choice","value":"Patch Size"},"shape-dimensions":{"type":"dimensions","value":[]}},"bounds":{"height":82,"width":195,"x":776,"y":538},"class":{"id":"77697265-EA26-47D6-985A-B4D5DC314BF7","version":0},"clock":"video","constants":{"antialiasing":{"type":"float","value":4},"material":{"type":"float4","value":[0.12549020349979401,0.76470589637756348,0.05490196123719215,1]},"shape":{"type":"procedural","value":null}},"hidden":[],"name":"Shape Render"},"13":{"at