					},
					"text": {
						"type": "string",
						"value": "1 - X\n\nThis mathematical function takes the input and subtracts it from 1.\n\nThis can be really usefull when you need to flip a 0 to 1 range to become a 1 to 0 range."
					}
				},
				"bounds": {
					"height": 134.5049285888671875,
					"width": 637.4144287109375,
					"x": 108.203125,
