          "text": {
            "type": "string",
            "value": "ROUND\nThe Round node rounds the incoming value to the nearest integer.\n\n1.4 becomes 1\n1.6 becomes 2\n-2.1 become -2\n1.5 becomes 2."
          }
        },
        "bounds": {
