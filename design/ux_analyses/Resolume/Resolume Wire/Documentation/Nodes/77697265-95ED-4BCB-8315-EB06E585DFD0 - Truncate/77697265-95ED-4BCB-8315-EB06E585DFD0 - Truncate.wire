			"19": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": true
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "TRUNCATE\nThe Truncate node rounds the incoming value down by removing everything after the decimal point.\n\nExample A: 1.4 becomes 1.\nExample B: 1.6 becomes 1.\n\nThe following patch contains all the basic rounding functions in Wire.\nUse the slider to adjust the value that is to be rounded.\nThe height of the red rectangle is directly modulated by the value slider.\nThe height of the pink rectangle is modulated by the truncated value.\n\nPatch Explained -\n\n• The slider provides a value between -5 and 5 to the rounding nodes. The Join node combines their values in an array so we can adres each instance of the rectangle in the Transform node.\n"
					}
				},
				"bounds": {
					"height": 337,
					"width": 811,
					"x": 280.5999755859375,
					"y": -53
				},
				"class": {
					"id": "77697265-3C1D-467D-A722-0FC566538374",
					"version": 1
				},
				"clock": "video",
				"color": "ffd0c117",
