					"text": {
						"type": "string",
						"value": "EXAMPLE: LUT RESOURCE\n\nIn this example we use the LUT 3D In node to have the user select a .cube file from their drive.\nThe LUT node is used to apply the loaded LUT."
					}
				},
				"bounds": {
					"height": 368,
					"width": 688.5404052734375,
