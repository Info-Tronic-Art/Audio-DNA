					"text": {
						"type": "string",
						"value": "BOX 2D\n\nThe Box 2D node constructs a Box 2D type out of two Float 2 values.\nA Box 2D type can be applied to the UV inlets of geometry nodes.\n\nGeometry, Slices and Meshes can be converted to Box 2D with the Bounding Box node"
					}
				},
				"bounds": {
					"height": 147.3980865478515625,
					"width": 632.8653564453125,
					"x": -56.32920074462890625,
