          "text": {
            "type": "string",
            "value": "EXAMPLE II : TRANSPOSING A RGB CHANNEL\n\nHere we are transposing a single texture channel.\nThis is done by unpacking the texture with Unpack, transposing it and repacking it with the Texture node."
          }
        },
        "bounds": {
