          "fill"
        ],
        "name": "Comment"
      },
      "71": {
        "attributes": {
          "alignment": {
            "type": "integer",
            "value": 0
          },
          "fill": {
            "type": "bool",
            "value": true
          },
          "font-size": {
            "type": "float",
            "value": 19
          },
          "text": {
            "type": "string",
            "value": "ACCUMULATE\n\nThe Accumulate node accumulates this incomming values. \nThe node will add up all the values it gets until it gets reset. \nThis can be compared to a \"+=\" operation in traditional programming. "
          }
        },
        "bounds": {
