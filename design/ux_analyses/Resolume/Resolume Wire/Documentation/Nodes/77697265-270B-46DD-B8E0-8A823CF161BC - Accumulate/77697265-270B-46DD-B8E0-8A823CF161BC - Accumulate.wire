          },
          "font-size": {
            "type": "float",
            "value": 19
          },
          "text": {
            "type": "string",
            "value": "EXAMPLE 2: RANDOM WALKER\n\nIn this example we are accumulating the float 2 value generated by the Random node.\nThis value is used to Move the Circle node around.\nAfter the Circle is rendered to a texture by the Shape Render node, we send it into a Video Mixer.\nThe Video Mixer is sent back into itself, creating a feedback look.\nThis way we can draw with the circle."
          }
        },
        "bounds": {
          "height": 678.3038940429688,
          "width": 1696.345947265625,
          "x": -425.3922729492187,
          "y": 1015.4960327148436
        },
        "class": {
