      "0": {
        "attributes": {
          "font-size": {
            "type": "number",
            "value": 19
          },
          "text": {
            "type": "text",
            "value": "WRITE PITCH BEND\n\nWrite Pitch Bend allows you to write a pitch bend message to a set channel.\n\nIn this example we write a randomized pitch bend on every beat. We added some smoothing to make the bend changes a little less harsh."
          }
        },
        "bounds": {
          "height": 164.24685668945312,
          "width": 661.3009033203125,
          "x": 445.7047119140625,
          "y": 173.0877227783203
        },
        "class": {
          "id": "77697265-3C1D-467D-A722-0FC566538374",
          "version": 0
        },
        "clock": "video",
        "constants": {},
        "hidden": [],
        "name": "Comment"
      },
      "1": {
        "attributes": {
          "font-size": {
            "type": "number",
            "value": 19
          },
          "text": {
            "type": "text",
            "value": "OUTLETS\n\n• Main\nOutputs a MIDI-message."
          }
        },
        "bounds": {
          "height": 297,
          "width": 334,
          "x": 552.041015625,
          "y": 694.5372314453125
