			"0": {
				"attributes": {
					"alignment": {
						"type": "integer",
						"value": 0
					},
					"fill": {
						"type": "bool",
						"value": true
					},
					"font-size": {
						"type": "float",
						"value": 19
					},
					"text": {
						"type": "string",
						"value": "PERLIN GENERATOR\n\nPerlin Generator is a smoothed noise generator.\nIt generates positive and negative floating point values between its amplitude.\nThe frequency defines how fast the generator modulates between values.\nThis node is great for random, but smooth modulation without the need for Random nodes.\n\nWhen instantiating the node, multiple different values should be used for the phase offset in order to generate unique values for each instance.\n\nThe unipolar setting can be used to force the generator to only produce positive or negative values.\nThis depends on the polarity of the amplitude.\n\nIf you need to replicate the same random values check out the Perlin node.\nThis is best used if you need to loop through the same set of semi-random values.\n"
					}
				},
				"bounds": {
					"height": 318.0582275390625,
					"width": 718.75738525390625,
					"x": 193.1539154052734375,
