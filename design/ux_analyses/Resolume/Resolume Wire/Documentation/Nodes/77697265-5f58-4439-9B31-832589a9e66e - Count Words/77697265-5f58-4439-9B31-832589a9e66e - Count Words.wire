let you analyse a string.\nIn this example we have the Count Words, Count Lines and Length node.\n\nThe Count Words node will give you the amount of words in a string.\nThe Count Lines node will give you the amount of lines in a string\nThe Length node will give you the amount of characters in a string, counting spaces too.\n\nIn this example we start with a multi-line string.\nWe analyse the amount of words, lines and characters in this string\nNext we concatenate everything into its own multi-line string before we render it out to the Text Render node. Note that the final Concatenate node has a break\/enter\/newline as its seperator.\n\nTry writing a new string and watch how the values update."}},"bounds":{"height":318.73052978515625,"width":682.8492431640625,"x":385.321929931640625,"y":-341.81982421875},"class":{"id":"77697265-3C1D-467D-A722-0FC566538374","version":0},"clock":"video","constants":{},"hidden":[],"name":"Comment"},"4":{"attributes":{"flow":{"type":"flow","value":"signal"},"input0-type":{"type":"type","value":"string"},"instances":{"type":"number","value":1}},"bounds":{"height":58,"width":195,"x":101.9576873779296875,"y":15.65374755859375},"class":{"id":"77697265-5852-4454-89e5-61a24cea2d50","version":0},"clock":"video","constants":{"input0":{"type":"string","value":"Hey Wire!\nHey You!"}},"hidden":[],"name":"String"},"41":{"attributes":{"instances":{"type":"number","value":1}},"bounds":{"height":82,"width":132,"x":1820.1484375,"y":14.9957122802734375},"class":{"id":"77697265-BEEA-4D38-8EE5-0EBA4CBD0AEE","version":0},"clock":"video","constants":{"input":{"type":"texture2d","value":null}},"hidden":[],"name":"Texture Out"},"5":{"attributes":{"flow":{"type":"flow","value":"signal"}},"bounds":{"height":30,"width":195,"x":407.92333984375,"y":526.69891357421875},"class":{"id":"77697265-5f58-4439-9a96-809989a9e66e","version":0},"clock":"video","constants":{"input0":{"type":"string","value":""}},"hidden":[],"name":"Length"},"6":{"attributes":{"bitdepth":{"ty