					"text": {
						"type": "string",
						"value": "EXAMPLE 1: PLAYBACK\n\nThis example shows the basic operation of the Video Player node.\nA video resource is assigned in the node panel and upon hitting the (Transport) Play button the video will start playing in loop mode."
					}
				},
				"bounds": {
					"height": 484.913238525390625,
					"width": 1105.4368896484375,
					"x": -344.1053466796875,
