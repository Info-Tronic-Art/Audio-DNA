					"text": {
						"type": "string",
						"value": "EXAMPLE 1: SUBTRACTING FLOAT 2\n\nIn this example we create a modulation source by combining two Perlin Generator oscillators into a Float2 type.\nThese values are then subtracted from the static values generated by the Grid Pattern node, breathing some life into the grid."
					}
				},
				"bounds": {
					"height": 650.49761962890625,
					"width": 1249.7501220703125,
					"x": 71.873291015625,
