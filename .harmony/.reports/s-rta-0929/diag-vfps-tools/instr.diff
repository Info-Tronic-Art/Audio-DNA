+#pragma once
+// DIAG-VFPS TEMPORARY DIAGNOSTIC INSTRUMENTATION (lane diag-vfps) -- never committed.
+// A lock-free record ring drained by a background thread to $ADNA_VFPS_FILE (TSV), a per-thread CPU / QoS sampler,
+// display / window state samples, and the JUCE DiagVfpsHook (display-link ticks, swapBuffers, render-thread waits).
+// Counterfactual switches (env): ADNA_VFPS_QOS, ADNA_VFPS_NOUPLOAD, ADNA_VFPS_BGRA, ADNA_VFPS_CLIENT, ADNA_VFPS_PBO.
+// Everything is inert unless the matching env var is set.
+#include <atomic>
+#include <cstdint>
+#include <cstdlib>
+
+namespace dvf
+{
+    uint64_t now() noexcept;                   // mach_absolute_time ticks
+    bool on() noexcept;
+    int cpu() noexcept;                        // pthread_cpu_number_np of the calling thread (-1 = unknown)
+    uint64_t threadCpuNs() noexcept;           // CLOCK_THREAD_CPUTIME_ID of the calling thread
+    void rec(int kind, double t, double a = 0, double b = 0, double c = 0, double d = 0) noexcept;
+    void startAll();                           // message thread, before the main window
+    void stopAll();
+    inline int envInt(const char* v) { const char* e = std::getenv(v); return e != nullptr ? std::atoi(e) : 0; }
+
+    // Counterfactual arms (read once).
+    struct Arms
+    {
+        int qos = 0;          // 1: GL USER_INTERACTIVE + decode threads USER_INITIATED; 2: GL UTILITY; 3: decode threads UTILITY only;
+                              // 4: GL USER_INTERACTIVE only (decoders unchanged)
+        int noUpload = 0;     // c1: 1 = after a player's first upload, reuse its texture (no glTexSubImage2D)
+        int bgra = 0;         // c2: 1 = sws -> BGRA, GL_BGRA + GL_UNSIGNED_INT_8_8_8_8_REV; 2 = BGRA + GL_UNSIGNED_BYTE
+        int client = 0;       // c3: 1 = Apple client storage + shared storage hint, one texture per ring slot (BGRA REV)
+        int pbo = 0;          // c3b: 1 = PBO (orphan + map + memcpy on the GL thread) then glTexSubImage2D from it
+        int upcap = 0;        // Q1: at most N video uploads per render frame (a player over the cap holds one more frame)
+        int iosurf = 0;       // c4a: IOSurface ring slots + CGLTexImageIOSurface2D rectangle textures + a GPU blit per new frame
+        int decStagger = 0;   // Q1: N ms x (player index mod 4) sleep before a ring-full-woken conversion (de-syncs the decoders)
+    };
+    const Arms& arms();
+
+    // GL-thread frame accumulators (only the GL thread touches them).
+    struct Frame
+    {
+        uint64_t uploadTicks = 0, uploadN = 0, memcpyTicks = 0;
+        uint64_t videoSyncTicks = 0;   // Renderer::syncMedia video branch (lookup + advance + uploadToTexture)
+        uint64_t uploadBytes = 0;
+    };
+    Frame& frame();
+    extern std::atomic<int> swapInterval;
+
+    // c4a helpers (IOSurface / CGL live in the .mm): a BGRA IOSurface, its lock, and its binding to a rectangle texture.
+    void* surfCreate(int w, int h, int* bytesPerRow, uint8_t** base);
+    void surfLock(void* s);
+    void surfUnlock(void* s);
+    void surfRelease(void* s);
+    int surfBindRect(void* s, unsigned tex, int w, int h);   // 0 = kCGLNoError
+    int surfBind2D(void* s, unsigned tex, int w, int h);     // GL_TEXTURE_2D target (IOSURF=2); 0 = kCGLNoError
+}
