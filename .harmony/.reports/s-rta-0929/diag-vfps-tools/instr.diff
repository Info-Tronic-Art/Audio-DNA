+namespace dvf
+{
+std::atomic<int> swapInterval { -1 };
+
+namespace
+{
+    struct Rec
+    {
+        std::atomic<uint64_t> seq { 0 };
+        double t = 0, a = 0, b = 0, c = 0, d = 0;
+        int kind = 0, thr = 0, cpu = -1;
+    };
+    constexpr uint64_t kN = 1u << 20;
+    Rec* ring = nullptr;
+    std::atomic<uint64_t> head { 0 };
+    uint64_t tail = 0;
+    std::atomic<bool> enabled { false };
+    std::atomic<bool> running { false };
+    FILE* out = nullptr;
+    std::thread drainTh;
+    uint64_t lost = 0;
+    Arms theArms;
+    Frame theFrame;
+    CVDisplayLinkRef probeLink = nullptr;
+
+    void hookFn(int kind, double a, double b, double c, double d)
+    {
+        rec(kind, a, b, c, d, 0.0);
+        if (kind == 2 || kind == 3)   // the GL render thread: its CPU time at this point (kind 7)
+            rec(7, (double) now(), (double) threadCpuNs(), (double) kind);
+    }
+
+    void drainOnce()
+    {
+        for (;;)
+        {
+            Rec& r = ring[tail & (kN - 1)];
+            const uint64_t s = r.seq.load(std::memory_order_acquire);
+            if (s == tail + 1)
+            {
+                std::fprintf(out, "R\t%d\t%d\t%d\t%.0f\t%.6f\t%.6f\t%.6f\t%.6f\n", r.kind, r.thr, r.cpu, r.t, r.a, r.b, r.c, r.d);
+                ++tail;
+            }
+            else if (s > tail + 1)
+            {
+                ++lost; ++tail;
+            }
+            else
+                break;
+        }
+    }
+
+    void sampleThreads(uint64_t t)
+    {
+        thread_act_array_t th = nullptr;
+        mach_msg_type_number_t n = 0;
+        if (task_threads(mach_task_self(), &th, &n) != KERN_SUCCESS)
+            return;
+        for (mach_msg_type_number_t i = 0; i < n; ++i)
+        {
+            thread_extended_info_data_t info {};
+            mach_msg_type_number_t cnt = THREAD_EXTENDED_INFO_COUNT;
+            thread_identifier_info_data_t idi {};
+            mach_msg_type_number_t cnt2 = THREAD_IDENTIFIER_INFO_COUNT;
+            if (thread_info(th[i], THREAD_EXTENDED_INFO, (thread_info_t) &info, &cnt) == KERN_SUCCESS
+                && thread_info(th[i], THREAD_IDENTIFIER_INFO, (thread_info_t) &idi, &cnt2) == KERN_SUCCESS)
+            {
+                char nm[80];
+                std::snprintf(nm, sizeof(nm), "%s", info.pth_name[0] ? info.pth_name : "-");
+                for (char* c = nm; *c; ++c) if (*c == '\t' || *c == ' ') *c = '_';
+                qos_class_t qos = QOS_CLASS_UNSPECIFIED;
+                int rel = 0;
+                if (pthread_t pt = pthread_from_mach_thread_np(th[i]))
+                    pthread_get_qos_class_np(pt, &qos, &rel);
+                std::fprintf(out, "C\t%llu\t%llu\t%u\t%llu\t%d\t%d\t%d\t%d\t%d\t%d\t%s\n", (unsigned long long) t,
+                             (unsigned long long) idi.thread_id, (unsigned) th[i],
+                             (unsigned long long) (info.pth_user_time + info.pth_system_time),
+                             info.pth_curpri, info.pth_priority, info.pth_policy, (int) qos, rel, info.pth_run_state, nm);
+            }
+            mach_port_deallocate(mach_task_self(), th[i]);
+        }
+        vm_deallocate(mach_task_self(), (vm_address_t) th, n * sizeof(thread_act_t));
+        double la[3] = { 0, 0, 0 };
+        getloadavg(la, 3);
+        std::fprintf(out, "L\t%llu\t%.2f\t%.2f\t%.2f\t%llu\n", (unsigned long long) t, la[0], la[1], la[2], (unsigned long long) lost);
+    }
+
+    void sampleDisplay()
+    {
+        dispatch_async(dispatch_get_main_queue(), ^{
+            if (out == nullptr || ! running.load())
+                return;
+            const uint64_t t = now();
+            NSScreen* scr = [NSScreen mainScreen];
+            NSWindow* win = nil;
+            for (NSWindow* w in [NSApp windows])
+                if ([w isVisible]) { win = w; break; }
+            NSScreen* wscr = win != nil ? [win screen] : scr;
+            double maxFps = 0, minRI = 0, maxRI = 0, gran = 0;
+            if (@available(macOS 12.0, *))
+            {
+                maxFps = (double) [wscr maximumFramesPerSecond];
+                minRI = [wscr minimumRefreshInterval];
+                maxRI = [wscr maximumRefreshInterval];
+                gran = [wscr displayUpdateGranularity];
+            }
+            const auto disp = (CGDirectDisplayID) [[[wscr deviceDescription] objectForKey: @"NSScreenNumber"] unsignedIntValue];
+            double modeHz = -1;
+            if (CGDisplayModeRef m = CGDisplayCopyDisplayMode(disp)) { modeHz = CGDisplayModeGetRefreshRate(m); CGDisplayModeRelease(m); }
+            double cvNominal = -1;
+            if (probeLink == nullptr)
+                CVDisplayLinkCreateWithCGDisplay(disp, &probeLink);
+            if (probeLink != nullptr)
+            {
+                const CVTime p = CVDisplayLinkGetNominalOutputVideoRefreshPeriod(probeLink);
+                if ((p.flags & kCVTimeIsIndefinite) == 0 && p.timeScale != 0)
+                    cvNominal = (double) p.timeValue / (double) p.timeScale;
+            }
+            const bool appActive = [NSApp isActive];
+            const bool appVisible = ([NSApp occlusionState] & NSApplicationOcclusionStateVisible) != 0;
+            const bool key = win != nil && [win isKeyWindow];
+            const bool mainW = win != nil && [win isMainWindow];
+            const bool winVisible = win != nil && ([win occlusionState] & NSWindowOcclusionStateVisible) != 0;
+            const int thermal = (int) [[NSProcessInfo processInfo] thermalState];
+            const bool lowPower = [[NSProcessInfo processInfo] isLowPowerModeEnabled];
+            std::fprintf(out, "D\t%llu\tdisp=%u\tmaxFps=%.1f\tminRI=%.6f\tmaxRI=%.6f\tgran=%.6f\tmodeHz=%.2f\tcvNominal=%.6f\t"
+                              "appActive=%d\tappVisible=%d\tkey=%d\tmain=%d\twinVisible=%d\tthermal=%d\tlowPower=%d\tswapInterval=%d\t"
+                              "win=%.0fx%.0f\tscale=%.1f\n",
+                         (unsigned long long) t, (unsigned) disp, maxFps, minRI, maxRI, gran, modeHz, cvNominal,
+                         appActive, appVisible, key, mainW, winVisible, thermal, lowPower, swapInterval.load(),
+                         win != nil ? [win frame].size.width : 0.0, win != nil ? [win frame].size.height : 0.0,
+                         win != nil ? [win backingScaleFactor] : 0.0);
+        });
+    }
+
+    void calibrate(qos_class_t q, const char* name)
+    {
+        std::thread([q, name] {
+            pthread_set_qos_class_self_np(q, 0);
+            std::set<int> seen;
+            for (int i = 0; i < 60; ++i)
+            {
+                const uint64_t t0 = now();
+                volatile double x = 0;
+                while (now() - t0 < 24000) x = x + 1.0;   // ~1 ms spin
+                seen.insert(cpu());
+                std::this_thread::sleep_for(std::chrono::milliseconds(2));
+            }
+            std::string s;
+            for (int c : seen) s += std::to_string(c) + ",";
+            rec(90, (double) now(), (double) q);
+            if (out != nullptr)
+                std::fprintf(out, "K\t%s\tqos=%d\tcpus=%s\n", name, (int) q, s.c_str());
+        }).detach();
+    }
+}
+
+uint64_t now() noexcept { return mach_absolute_time(); }
+bool on() noexcept { return enabled.load(std::memory_order_relaxed); }
+int cpu() noexcept { size_t c = 0; return pthread_cpu_number_np(&c) == 0 ? (int) c : -1; }
+uint64_t threadCpuNs() noexcept { return clock_gettime_nsec_np(CLOCK_THREAD_CPUTIME_ID); }
+const Arms& arms() { return theArms; }
+Frame& frame() { return theFrame; }
+
+void rec(int kind, double t, double a, double b, double c, double d) noexcept
+{
+    if (! enabled.load(std::memory_order_relaxed))
+        return;
+    const uint64_t i = head.fetch_add(1, std::memory_order_relaxed);
+    Rec& r = ring[i & (kN - 1)];
+    r.t = t; r.a = a; r.b = b; r.c = c; r.d = d; r.kind = kind;
+    r.thr = (int) pthread_mach_thread_np(pthread_self());
+    r.cpu = cpu();
+    r.seq.store(i + 1, std::memory_order_release);
+}
+
+void startAll()
+{
+    theArms.qos = envInt("ADNA_VFPS_QOS");
+    theArms.noUpload = envInt("ADNA_VFPS_NOUPLOAD");
+    theArms.bgra = envInt("ADNA_VFPS_BGRA");
+    theArms.client = envInt("ADNA_VFPS_CLIENT");
+    theArms.pbo = envInt("ADNA_VFPS_PBO");
+    theArms.upcap = envInt("ADNA_VFPS_UPCAP");
+    theArms.iosurf = envInt("ADNA_VFPS_IOSURF");
+    theArms.decStagger = envInt("ADNA_VFPS_DECSTAGGER");
+    const char* path = std::getenv("ADNA_VFPS_FILE");
+    if (path == nullptr || path[0] == 0)
+        return;
+    out = std::fopen(path, "w");
+    if (out == nullptr)
+        return;
+    std::setvbuf(out, nullptr, _IOFBF, 1 << 20);
+    ring = new Rec[kN];
+    mach_timebase_info_data_t tb {};
+    mach_timebase_info(&tb);
+    std::fprintf(out, "H\t%u\t%u\t%llu\tpid=%d\tqos=%d\tnoUpload=%d\tbgra=%d\tclient=%d\tpbo=%d\tmainQos=%d\tupcap=%d\tiosurf=%d\tdecStagger=%d\n", tb.numer, tb.denom,
+                 (unsigned long long) now(), (int) getpid(), theArms.qos, theArms.noUpload, theArms.bgra, theArms.client,
+                 theArms.pbo, (int) qos_class_self(), theArms.upcap, theArms.iosurf, theArms.decStagger);
+    enabled = true;
+    running = true;
+    juce::DiagVfpsHook::fn = &hookFn;
+    calibrate(QOS_CLASS_BACKGROUND, "background");
+    calibrate(QOS_CLASS_USER_INTERACTIVE, "userInteractive");
+
+    drainTh = std::thread([] {
+        pthread_setname_np("dvf.drain");
+        pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+        uint64_t lastSample = 0, lastDisp = 0;
+        while (running.load())
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+            drainOnce();
+            const uint64_t t = now();
+            if (t - lastSample >= 24000000ull / 4)   // 250 ms
+            {
+                sampleThreads(t);
+                lastSample = t;
+            }
+            if (t - lastDisp >= 24000000ull * 2)     // 2 s
+            {
+                sampleDisplay();
+                lastDisp = t;
+            }
+            std::fflush(out);
+        }
+        drainOnce();
+        std::fflush(out);
+    });
+}
+
+void* surfCreate(int w, int h, int* bytesPerRow, uint8_t** base)
+{
+    NSDictionary* props = @{ (id) kIOSurfaceWidth: @(w), (id) kIOSurfaceHeight: @(h), (id) kIOSurfaceBytesPerElement: @4,
+                             (id) kIOSurfacePixelFormat: @((unsigned) 'BGRA') };
+    IOSurfaceRef s = IOSurfaceCreate((CFDictionaryRef) props);
+    if (s == nullptr)
+        return nullptr;
+    *bytesPerRow = (int) IOSurfaceGetBytesPerRow(s);
+    IOSurfaceLock(s, 0, nullptr);
+    *base = (uint8_t*) IOSurfaceGetBaseAddress(s);
+    IOSurfaceUnlock(s, 0, nullptr);
+    return (void*) s;
+}
+void surfLock(void* s) { IOSurfaceLock((IOSurfaceRef) s, 0, nullptr); }
+void surfUnlock(void* s) { IOSurfaceUnlock((IOSurfaceRef) s, 0, nullptr); }
+void surfRelease(void* s) { if (s != nullptr) CFRelease((IOSurfaceRef) s); }
+int surfBindRect(void* s, unsigned tex, int w, int h)
+{
+    glBindTexture(GL_TEXTURE_RECTANGLE, tex);
+    const CGLError e = CGLTexImageIOSurface2D(CGLGetCurrentContext(), GL_TEXTURE_RECTANGLE, GL_RGBA8, w, h, GL_BGRA,
+                                              GL_UNSIGNED_INT_8_8_8_8_REV, (IOSurfaceRef) s, 0);
+    glBindTexture(GL_TEXTURE_RECTANGLE, 0);
+    return (int) e;
+}
+int surfBind2D(void* s, unsigned tex, int w, int h)
+{
+    glBindTexture(GL_TEXTURE_2D, tex);
+    const CGLError e = CGLTexImageIOSurface2D(CGLGetCurrentContext(), GL_TEXTURE_2D, GL_RGBA8, w, h, GL_BGRA,
+                                              GL_UNSIGNED_INT_8_8_8_8_REV, (IOSurfaceRef) s, 0);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    return (int) e;
+}
+
+void stopAll()
+{
+    if (! running.load())
+        return;
+    juce::DiagVfpsHook::fn = nullptr;
+    running = false;
+    if (drainTh.joinable()) drainTh.join();
+    enabled = false;
+}
+}
