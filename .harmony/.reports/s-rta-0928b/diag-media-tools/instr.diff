@@ -0,0 +1,154 @@
+#pragma once
+// TEMPORARY DIAGNOSTIC INSTRUMENTATION (lane diag-media, s-rta-0928b) -- never committed.
+// steady_clock scopes + a message-thread heartbeat + GL per-frame media accumulators, written to stderr.
+// Marker strings: DIAGMEDIA
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <thread>
+#include <juce_events/juce_events.h>
+
+namespace diag
+{
+    inline std::chrono::steady_clock::time_point origin()
+    {
+        static const auto o = std::chrono::steady_clock::now();
+        return o;
+    }
+    inline double nowMs()
+    {
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - origin()).count();
+    }
+    inline int& depth()
+    {
+        thread_local int d = 0;
+        return d;
+    }
+    // DIAGMEDIA env flags: read once per name (counterfactual arms: the same binary, a behaviour switched off).
+    inline bool flag(const char* name)
+    {
+        const char* v = std::getenv(name);
+        return v != nullptr && v[0] == '1';
+    }
+    // A scope logs "[DG] start_ms depth name dur_ms" when dur >= minMs (always when minMs < 0).
+    struct Scope
+    {
+        const char* name;
+        double minMs;
+        double t0;
+        int d;
+        explicit Scope(const char* n, double min = 0.25) : name(n), minMs(min), t0(nowMs()), d(depth()++) {}
+        ~Scope()
+        {
+            --depth();
+            const double dur = nowMs() - t0;
+            if (minMs < 0.0 || dur >= minMs)
+                std::fprintf(stderr, "[DG] %.3f %d %s %.3f\n", t0, d, name, dur);
+        }
+    };
+    inline void event(const char* what, int a = 0, int b = 0, int c = 0, int e = 0)
+    {
+        std::fprintf(stderr, "[EV] %.3f %s %d %d %d %d\n", nowMs(), what, a, b, c, e);
+    }
+
+    // GL-thread per-frame accumulators (thread_local: only the GL thread renders; the message thread's copies are
+    // separate and never printed).
+    struct GlAcc
+    {
+        int vidCalls = 0, vidDec = 0, vidSeek = 0, vidUpl = 0, vidConv = 0;
+        double vidAdvMs = 0, vidDecMs = 0, vidSeekMs = 0, vidConvMs = 0, vidFlipMs = 0, vidUplMs = 0, vidLockMs = 0;
+        int exists = 0; double existsMs = 0;
+        int seqCalls = 0, seqUpl = 0; double seqMs = 0, seqUplMs = 0;
+        double fwMs = -1, compMs = -1, pumpMs = 0; int deckActive = -1;
+        void reset() { *this = GlAcc{}; }
+    };
+    inline GlAcc& gl()
+    {
+        thread_local GlAcc a;
+        return a;
+    }
+    // A timed stat on the GL thread (S4): existsAsFile() with its cost in the frame accumulator.
+    template <class F>
+    inline bool timedExists(const F& file)
+    {
+        static const bool off = flag("DIAG_NO_EXISTS");
+        if (off)
+            return true;   // counterfactual arm: every fixture exists, so the result is the same
+        const double t0 = nowMs();
+        const bool r = file.existsAsFile();
+        gl().exists++;
+        gl().existsMs += nowMs() - t0;
+        return r;
+    }
+
+    // REST hook (/api/diag/media, TEST-ONLY build + DIAG_MEDIA_HOOK=1): MainComponent installs the handler.
+    inline std::function<void(const std::string&)>& mediaHook()
+    {
+        static std::function<void(const std::string&)> h;
+        return h;
+    }
+
+    // Heartbeat: one callAsync ping in flight at a time; when served, the latency (serve - post) is
+    // logged if >= 2 ms; the next ping is posted 2 ms after the previous one was served.
+    struct Heartbeat
+    {
+        std::atomic<bool> running { false };
+        std::atomic<bool> served { true };
+        std::atomic<double> postT { 0.0 };
+        std::thread th;
+        long n = 0;
+        double maxLat = 0.0;
+
+        void start()
+        {
+            running = true;
+            th = std::thread([this] {
+                double lastSummary = nowMs();
+                while (running.load())
+                {
+                    if (served.load())
+                    {
+                        served = false;
+                        postT = nowMs();
+                        juce::MessageManager::callAsync([this] {
+                            const double t = nowMs();
+                            const double lat = t - postT.load();
+                            ++n;
+                            if (lat > maxLat) maxLat = lat;
+                            if (lat >= 2.0)
+                                std::fprintf(stderr, "[HB] %.3f %.3f\n", postT.load(), lat);
+                            served = true;
+                        });
+                    }
+                    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+                    const double t = nowMs();
+                    if (t - lastSummary > 10000.0)
+                    {
+                        std::fprintf(stderr, "[HBS] %.3f n=%ld max=%.3f\n", t, n, maxLat);
+                        lastSummary = t;
+                    }
+                }
+            });
+        }
+        void stop()
+        {
+            running = false;
+            if (th.joinable())
+                th.join();
+        }
+    };
+    inline Heartbeat& heartbeat()
+    {
+        static Heartbeat* hb = new Heartbeat();   // leaked: a late callAsync never touches freed memory
+        return *hb;
+    }
+}
+
+#define DIAG_CAT2(a, b) a##b
+#define DIAG_CAT(a, b) DIAG_CAT2(a, b)
+#define DIAG_SCOPE(name) diag::Scope DIAG_CAT(diagScope_, __LINE__)(name)
+#define DIAG_SCOPE_MIN(name, ms) diag::Scope DIAG_CAT(diagScope_, __LINE__)(name, ms)
