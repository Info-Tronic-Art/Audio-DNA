diff --git a/src/render/FboTrace.h b/src/render/FboTrace.h
new file mode 100644
index 0000000..bccdaa4
--- /dev/null
+++ b/src/render/FboTrace.h
@@ -0,0 +1,89 @@
+#pragma once
+// TEMPORARY s-rta-0926 parity-lane diagnostic (AUDIODNA_FBO_TRACE=1). Not for merge -- kept only as
+// .harmony/.reports/s-rta-0926/parity-trace.diff. Logs every compositor / present draw of a traced
+// frame: target FBO -> colour attachment, FBO status, every sampler the bound program samples and the
+// texture on its unit (FEEDBACK flag if it is the attachment), glGetError, and a centre 8x8 readback.
+#include <juce_opengl/juce_opengl.h>
+#include <cstdio>
+#include <cstdlib>
+#include <atomic>
+
+namespace FboTrace
+{
+using namespace juce::gl;
+
+inline bool enabled()
+{
+    static const bool on = std::getenv("AUDIODNA_FBO_TRACE") != nullptr;
+    return on;
+}
+
+// Frames still to trace (set on a clip change / pending capture); frame counter for log lines.
+inline std::atomic<int>& framesLeft() { static std::atomic<int> v { 0 }; return v; }
+inline std::atomic<long>& frameNo() { static std::atomic<long> v { 0 }; return v; }
+inline bool active() { return enabled() && framesLeft().load(std::memory_order_relaxed) > 0; }
+
+inline void centreMean(GLuint readFbo, int w, int h, float out[4], GLenum& err)
+{
+    GLint prevRead = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &prevRead);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, readFbo);
+    unsigned char px[8 * 8 * 4] = {};
+    glReadPixels(w / 2 - 4, h / 2 - 4, 8, 8, GL_RGBA, GL_UNSIGNED_BYTE, px);
+    err = glGetError();
+    for (int c = 0; c < 4; ++c) out[c] = 0.0f;
+    for (int i = 0; i < 64; ++i)
+        for (int c = 0; c < 4; ++c) out[c] += px[i * 4 + c] / 64.0f;
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, static_cast<GLuint>(prevRead));
+}
+
+// Call right AFTER a draw. Inspects the currently bound DRAW framebuffer and program.
+inline void draw(const char* stage, int w, int h, GLuint note = 0)
+{
+    if (!active()) return;
+    GLenum errDraw = glGetError();
+    GLint drawFbo = 0, prog = 0, activeUnit = 0;
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawFbo);
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prog);
+    glGetIntegerv(GL_ACTIVE_TEXTURE, &activeUnit);
+    GLint attach = 0;
+    GLenum status = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+    if (drawFbo != 0)
+        glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                                              GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &attach);
+    char samplers[512] = {};
+    int off = 0;
+    bool feedback = false;
+    if (prog != 0)
+    {
+        GLint n = 0;
+        glGetProgramiv(static_cast<GLuint>(prog), GL_ACTIVE_UNIFORMS, &n);
+        for (GLint i = 0; i < n && off < 440; ++i)
+        {
+            char name[64]; GLsizei len = 0; GLint size = 0; GLenum type = 0;
+            glGetActiveUniform(static_cast<GLuint>(prog), static_cast<GLuint>(i), sizeof(name), &len, &size, &type, name);
+            if (type != GL_SAMPLER_2D) continue;
+            GLint unit = -1;
+            glGetUniformiv(static_cast<GLuint>(prog), glGetUniformLocation(static_cast<GLuint>(prog), name), &unit);
+            GLint tex = 0;
+            glActiveTexture(GL_TEXTURE0 + static_cast<GLenum>(unit));
+            glGetIntegerv(GL_TEXTURE_BINDING_2D, &tex);
+            if (drawFbo != 0 && tex == attach) feedback = true;
+            off += std::snprintf(samplers + off, sizeof(samplers) - static_cast<size_t>(off),
+                                 " %s@u%d=tex%d", name, unit, tex);
+        }
+        glActiveTexture(static_cast<GLenum>(activeUnit));
+    }
+    float m[4]; GLenum errRead = 0;
+    centreMean(static_cast<GLuint>(drawFbo), w, h, m, errRead);
+    std::fprintf(stderr, "[FBOTRACE] f%ld %-22s drawFBO=%d->tex%d status=0x%x prog=%d%s%s errDraw=0x%x errRead=0x%x centre=(%.0f,%.0f,%.0f,%.0f) note=%u\n",
+                 frameNo().load(), stage, drawFbo, attach, status, prog, samplers,
+                 feedback ? " FEEDBACK!" : "", errDraw, errRead, m[0], m[1], m[2], m[3], note);
+}
+
+inline void msg(const char* text, long a = 0, long b = 0, long c = 0, long d = 0)
+{
+    if (!active()) return;
+    std::fprintf(stderr, "[FBOTRACE] f%ld %s %ld %ld %ld %ld\n", frameNo().load(), text, a, b, c, d);
+}
+} // namespace FboTrace
