# The SCRATCH-only REST hook used for the ITEM 1 RED/GREEN live witness (built into the two witness
# app snapshots only; removed before commit f8d1d6e -- `grep -c SCRATCH src/MainComponent.cpp` == 0).
# It is reached through POST /api/routine/set {"slot":0,"name":"__scratch_stop_button"|"__scratch_stop_binding"}
# and calls the REAL handlers: topBar_->onStop() and handleBindingAction(GlobalStop, 1.0).
--- a/src/MainComponent.cpp  (perfRoutineSet, top)
+++ b/src/MainComponent.cpp
@@ std::string MainComponent::perfRoutineSet(const ApiServer::RoutineSetOpts& opts)
 {
+    // SCRATCH-HOOK-ROUTINES-FOLLOWUP (ITEM 1 RED/GREEN witness only -- NEVER committed)
+    if (opts.name == "__scratch_stop_button") { if (topBar_ && topBar_->onStop) topBar_->onStop(); return {}; }
+    if (opts.name == "__scratch_stop_binding") { Binding b; b.action = Binding::Action::GlobalStop; handleBindingAction(b, 1.0f); return {}; }
     Routine* routine = composition_.routineInSlot(opts.slot);
